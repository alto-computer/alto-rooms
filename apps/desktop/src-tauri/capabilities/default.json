{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main Alto Rooms window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/roomsd", "sidecar": true }]
    },
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$HOME/rooms/**" }]
    }
  ]
}
