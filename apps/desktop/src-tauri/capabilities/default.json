{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main Alto Rooms window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$HOME/rooms/**" }]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://console.typesafe.ai/*" }]
    }
  ]
}
